# Maasinga dashboard: settings for running the dashboard WITHOUT Docker.
# Copy to dashboard/.env.local and edit:   cp .env.example .env.local
# (With Docker Compose, PUBLIC_API_URL in deploy/.env sets this for you.)

# Address of the Maasinga API, as the browser sees it (required: the dashboard reads all data from it).
# The dashboard asks for a login; users are made with api/users.py (see docs/SETUP.md).
# Restart the dev server after changing it.
NEXT_PUBLIC_API_URL=http://localhost:8000
