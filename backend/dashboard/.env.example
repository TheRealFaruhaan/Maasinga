# Maasinga dashboard: settings for running the dashboard WITHOUT Docker.
# Copy to dashboard/.env.local and edit:   cp .env.example .env.local
# (With Docker Compose, PUBLIC_API_URL in deploy/.env sets this for you.)

# Address of the Maasinga API, as the browser sees it.
# Leave it empty to run the dashboard on its own: it then reads the data files in public/data.
# If the API cannot be reached, the dashboard also falls back to those files.
NEXT_PUBLIC_API_URL=http://localhost:8000
