# Maasinga API: settings for running the API and seed.py WITHOUT Docker.
# Copy to api/.env and edit:   cp .env.example .env
# (With Docker Compose, use deploy/.env instead; this file is not used there.)

# PostgreSQL connection. Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Create the database first, for example:
#   createuser maasinga --pwprompt
#   createdb maasinga --owner maasinga
DATABASE_URL=postgresql://maasinga:change-me@localhost:5432/maasinga

# Websites allowed to call the API from a browser. "*" = any.
# Example for a server: CORS_ORIGINS=https://maasinga.your-domain.com
CORS_ORIGINS=*

# Folder with the 20 data files that seed.py loads. Leave empty to use ../data/out.
DATA_DIR=

# Secret that signs login tokens (32 or more random characters):   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value-of-64-characters

# First admin login, created by seed.py if it does not exist yet. Leave ADMIN_PASSWORD empty to skip.
# More users:   python users.py add <name> [--role policy|admin]
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
