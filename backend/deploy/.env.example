# Maasinga: settings for Docker Compose (deploy/docker-compose.yml).
# Copy this file to deploy/.env and edit it:   cp .env.example .env
# Never commit the real .env (it holds the database password).

# ---- Database ----
# Password for the "maasinga" PostgreSQL user. Use a long random value, for example:
#   openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# ---- Logins ----
# Secret that signs login tokens. Use a long random value and keep it private:
#   openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-value-of-64-characters

# First admin login, created once when the database is seeded (later changes here are ignored;
# use "docker compose exec api python users.py add <name> --role admin" instead).
# The dashboard and the protected API routes need a login. Leave ADMIN_PASSWORD empty to skip.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# ---- API ----
# The address that web browsers use to reach the API. It is built into the dashboard when the
# dashboard image is built, so rebuild the dashboard after changing it:
#   docker compose up -d --build dashboard
# On your own computer:   http://localhost:8000
# On a server:            https://maasinga-api.your-domain.com
PUBLIC_API_URL=http://localhost:8000

# Which websites may call the API from a browser (CORS).
# "*" allows any website (fine on your own computer).
# On a server, list the dashboard address(es), separated by commas:
#   CORS_ORIGINS=https://maasinga.your-domain.com
CORS_ORIGINS=*

# ---- Ports on this machine ----
# Change these only if 8000 or 3000 is already in use.
API_PORT=8000
DASHBOARD_PORT=3000
