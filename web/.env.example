# Maasinga web app (public trip planner + policy dashboard at /policy).
# Copy to .env.local and edit:   cp .env.example .env.local
# Without a .env.local the app uses the hosted API below.

# Maasinga API, as the BROWSER reaches it. Used by the public app (islands,
# schedules, forecast, apps...). It is built into the app at build time, so
# rebuild (npm run build) after changing it. The API's CORS_ORIGINS must allow
# this web app's address.
NEXT_PUBLIC_MAASINGA_API=https://maasinga-api.devoup.com

# Maasinga API, as THIS SERVER reaches it. Used only by the policy dashboard:
# /policy/api/* logs in and fetches the protected data from the server side,
# so the login token never reaches the browser. Read at runtime (restart after
# changing). Leave empty to use NEXT_PUBLIC_MAASINGA_API.
# Example when the API runs on the same machine:   MAASINGA_API=http://127.0.0.1:8000
MAASINGA_API=
